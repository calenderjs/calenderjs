/** @jsxImportSource @wsxjs/wsx-core */
import { LightComponent, autoRegister, state } from "@wsxjs/wsx-core";
import { i18n } from "@wsxjs/wsx-i18next";
import "@wsxjs/wsx-base-components";
import "@calenderjs/calendar";
import type { Event as CalendarEvent } from "@calenderjs/event-model";
import styles from "./DemosPage.css?inline";

/** 站点内嵌日历演示用初始示例事件 */
const INITIAL_EVENTS: CalendarEvent[] = [
  {
    id: "site-demo-1",
    type: "meeting",
    title: "团队会议",
    startTime: new Date(new Date().toISOString().slice(0, 10) + "T10:00:00.000Z"),
    endTime: new Date(new Date().toISOString().slice(0, 10) + "T11:00:00.000Z"),
    data: { attendees: ["a@example.com"], location: "会议室 A" },
  },
  {
    id: "site-demo-2",
    type: "meeting",
    title: "客户演示",
    startTime: new Date(new Date().toISOString().slice(0, 10) + "T14:00:00.000Z"),
    endTime: new Date(new Date().toISOString().slice(0, 10) + "T15:30:00.000Z"),
    data: { attendees: ["b@example.com"], location: "线上" },
  },
];

@autoRegister({ tagName: "demos-page" })
@i18n("common")
export class DemosPage extends LightComponent {
  @state private _events: CalendarEvent[] = INITIAL_EVENTS;
  @state private _editingEvent: CalendarEvent | null = null;
  @state private _editingTitle: string = "";
  @state private _editError: string = "";

  constructor() {
    super({ styles, styleName: "demos-page" });
  }

  /** 当前日期 ISO 字符串，供 wsx-calendar date 属性使用 */
  private get _dateStr() {
    return new Date().toISOString().slice(0, 10);
  }

  /** 自定义事件默认冒泡，监听在组件根节点上即可，不受 wsx-calendar 子树重渲染影响 */
  onConnected() {
    this.addEventListener("event-edit-request", this._handleEditRequest as EventListener);
    this.addEventListener("event-update", this._handleUpdate as EventListener);
    this.addEventListener("event-update-denied", this._handleUpdateDenied as EventListener);
    this.addEventListener("event-update-error", this._handleUpdateError as EventListener);
  }

  onDisconnected() {
    this.removeEventListener("event-edit-request", this._handleEditRequest as EventListener);
    this.removeEventListener("event-update", this._handleUpdate as EventListener);
    this.removeEventListener("event-update-denied", this._handleUpdateDenied as EventListener);
    this.removeEventListener("event-update-error", this._handleUpdateError as EventListener);
  }

  private _handleEditRequest = (e: CustomEvent<{ event: CalendarEvent }>) => {
    this._editingEvent = { ...e.detail.event };
    this._editingTitle = e.detail.event.title;
    this._editError = "";
  };

  private _handleUpdate = (e: CustomEvent<{ event: CalendarEvent }>) => {
    const updated = e.detail.event;
    this._events = this._events.map((item) =>
      item.id === updated.id ? { ...item, ...updated } : item,
    );
    this._editingEvent = null;
  };

  private _handleUpdateDenied = () => {
    this._editError = "没有编辑此事件的权限";
  };

  private _handleUpdateError = (e: CustomEvent<{ errors: string[] }>) => {
    this._editError = `校验失败: ${e.detail.errors.join("、") || "请检查输入"}`;
  };

  private _handleSave = () => {
    if (!this._editingEvent) return;
    const calendar = this.querySelector("wsx-calendar") as
      | (HTMLElement & { proposeEventUpdate?: (event: CalendarEvent) => boolean })
      | null;
    if (!calendar?.proposeEventUpdate) return;
    calendar.proposeEventUpdate({ ...this._editingEvent, title: this._editingTitle });
  };

  private _handleCancel = () => {
    this._editingEvent = null;
    this._editError = "";
  };

  render() {
    return (
      <div class="demos-page">
        <section class="demos-hero">
          <div class="demos-hero-container">
            <h1 class="demos-hero-title">{this.t("demosTitle")}</h1>
            <p class="demos-hero-description">{this.t("demosDescription")}</p>
          </div>
        </section>
        <section class="demos-calendar">
          <div class="demos-calendar-container">
            <p class="demos-calendar-caption">月 / 周 / 日视图，双击事件可编辑标题。</p>
            <div class="demos-calendar-wrap">
              <wsx-calendar
                view="month"
                date={this._dateStr}
                events={JSON.stringify(this._events)}
              />
            </div>
            {this._editingEvent && (
              <div class="demos-edit-backdrop" data-testid="demos-edit-backdrop">
                <div class="demos-edit-dialog" role="dialog" aria-modal="true" data-testid="demos-edit-dialog">
                  <h2 class="demos-edit-title">编辑事件</h2>
                  <label class="demos-edit-field">
                    <span>标题</span>
                    <input
                      type="text"
                      data-testid="demos-edit-input-title"
                      value={this._editingTitle}
                      onInput={(ev: Event) => {
                        this._editingTitle = (ev.target as HTMLInputElement).value;
                      }}
                    />
                  </label>
                  {this._editError && (
                    <p class="demos-edit-error" role="alert" data-testid="demos-edit-error">
                      {this._editError}
                    </p>
                  )}
                  <div class="demos-edit-actions">
                    <button type="button" onClick={this._handleCancel}>取消</button>
                    <button type="button" data-testid="demos-edit-save" onClick={this._handleSave}>保存</button>
                  </div>
                </div>
              </div>
            )}
          </div>
        </section>
      </div>
    );
  }
}

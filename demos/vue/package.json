{
  "name": "@calenderjs/demos-vue",
  "version": "0.3.1",
  "private": true,
  "description": "CalenderJS Vue 3 组件演示网站",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:e2e": "vite build --config vite.e2e.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report",
    "lint": "eslint src",
    "clean": "rm -rf dist .vite",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@calenderjs/calendar": "workspace:*",
    "@calenderjs/core": "workspace:*",
    "@calenderjs/event-model": "workspace:*",
    "@calenderjs/vue": "workspace:*",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^20.19.27",
    "@vitejs/plugin-vue": "^6.0.11",
    "@wsxjs/wsx-vite-plugin": "^0.2.0",
    "eslint": "^9.39.2",
    "eslint-plugin-vue": "^10.12.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.51.0",
    "vite": "^7.3.8",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "^2.2.0"
  }
}

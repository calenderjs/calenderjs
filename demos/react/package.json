{
  "name": "@calenderjs/demos-react",
  "version": "0.3.1",
  "private": true,
  "description": "CalenderJS React 组件演示网站",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test && node ./e2e/check-coverage.mjs",
    "build:e2e": "vite build --config vite.e2e.config.ts",
    "test:e2e:report": "playwright show-report",
    "lint": "eslint src",
    "clean": "rm -rf dist .vite",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@calenderjs/core": "workspace:*",
    "@calenderjs/event-dsl": "workspace:*",
    "@calenderjs/event-model": "workspace:*",
    "@calenderjs/event-runtime": "workspace:*",
    "@calenderjs/monaco-event-dsl": "workspace:*",
    "@calenderjs/react": "workspace:*",
    "@calenderjs/react-event-editor": "workspace:*",
    "@monaco-editor/react": "^4.7.0",
    "monaco-editor": "^0.55.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^20.19.27",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.4",
    "@wsxjs/wsx-vite-plugin": "^0.2.0",
    "eslint": "^9.39.2",
    "monocart-reporter": "^2.13.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.51.0",
    "vite": "^7.3.0"
  }
}

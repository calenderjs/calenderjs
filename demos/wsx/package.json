{
  "name": "@calenderjs/demos-wsx",
  "version": "0.3.1",
  "private": true,
  "description": "CalenderJS 原生 Web Component 技术 demo（不依赖任何框架）",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:e2e": "vite build --config vite.e2e.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report",
    "lint": "eslint src",
    "clean": "rm -rf dist .vite",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@calenderjs/calendar": "workspace:*",
    "@calenderjs/core": "workspace:*",
    "@calenderjs/event-model": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^20.19.27",
    "@wsxjs/wsx-vite-plugin": "^0.2.0",
    "eslint": "^9.39.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.51.0",
    "vite": "^7.3.8"
  }
}

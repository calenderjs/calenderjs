{
  "name": "@calenderjs/vue",
  "version": "0.3.1",
  "description": "Vue 3 wrapper for @calenderjs/calendar Web Component",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build && pnpm verify:bundle",
    "verify:bundle": "node scripts/verify-vue-externals.mjs",
    "test": "vitest run",
    "lint": "eslint src",
    "typecheck": "vue-tsc --noEmit",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "@calenderjs/calendar": "workspace:*",
    "@calenderjs/core": "workspace:*",
    "@calenderjs/event-model": "workspace:*"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.27",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/test-utils": "^2.4.6",
    "eslint-plugin-vue": "^10.12.1",
    "vue-eslint-parser": "^10.4.2",
    "happy-dom": "^20.0.11",
    "typescript": "^5.9.3",
    "vite": "^7.3.8",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^2.1.9",
    "vue": "^3.5.13",
    "vue-tsc": "^2.2.0"
  }
}

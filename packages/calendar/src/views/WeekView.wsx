/** @jsxImportSource @wsxjs/wsx-core */
import { WebComponent, autoRegister, state } from "@wsxjs/wsx-core";
import type { Event } from "@calenderjs/event-model";
import type { User } from "@calenderjs/core";
import { getWeekDates, isSameDay, getTimeString } from "@calenderjs/date-time";
import {
    getEventsForDate,
    sortEventsByTime,
    calculateEventPosition,
} from "../utils/event-utils";
import {
    fromStateIso,
    normalizeEventsForState,
    toStateIso,
    toStateIsoOrUnselected,
    UNSELECTED_DATE_ISO,
} from "../utils/state-date";
import { upgradeProperties } from "../utils/upgrade-property";
import { startPointerDrag, findMatchAtPoint } from "../utils/pointer-drag";
import { DEFAULT_HOUR_CELL_HEIGHT_PX, snapMinuteWithinHour, snapMinutesFromPixelOffset } from "../utils/time-grid";
import styles from "./WeekView.css?inline";

/** 需要在 customElements 升级时补写的公开属性 */
const UPGRADABLE_PROPS = ["viewDate", "events", "selectedDate", "user"] as const;

/**
 * 周视图组件
 */
@autoRegister({ tagName: "wsx-week-view" })
export default class WeekView extends WebComponent {
    // ========== 观察的属性 ==========
    static get observedAttributes() {
        return ["view-date", "events", "selected-date", "user"];
    }

    // ========== 内部状态 ==========
    // 日期存 ISO：避免 WSX reactive Proxy 破坏 Date
    @state private _viewDateIso: string = new Date().toISOString();
    @state private _events: Event[] = [];
    @state private _selectedDateIso: string = UNSELECTED_DATE_ISO;
    private _scrollTop: number = 0;
    private _viewportHeight: number = 0;
    @state private _virtualScrollBucket: number = 0;
    // 拖拽改时间过程中的实时视觉偏移（RFC-0032）；松手后清空，不参与数据提交
    @state private _dragPreview: { eventId: string; dx: number; dy: number } | null = null;
    @state private _user: User = {
        id: "1",
        email: "john.doe@example.com",
        role: "user",
    };
    // 保存"今天"的日期，确保在切换视图时不会改变
    private readonly _today: Date;

    // ========== Property 访问器（WSX 组件之间使用） ==========
    get viewDate(): Date {
        return fromStateIso(this._viewDateIso);
    }
    set viewDate(value: Date | string) {
        try {
            this._viewDateIso = toStateIso(value);
        } catch {
            // 忽略无效日期
        }
    }

    get events(): Event[] {
        return this._events;
    }
    set events(value: Event[] | string) {
        this.captureScrollPosition();
        if (Array.isArray(value)) {
            this._events = normalizeEventsForState(value) as Event[];
        } else if (typeof value === "string") {
            try {
                const parsed = JSON.parse(value) as Event[];
                this._events = Array.isArray(parsed)
                    ? (normalizeEventsForState(parsed) as Event[])
                    : [];
            } catch (e) {
                console.error("Invalid events JSON:", value);
                this._events = [];
            }
        } else {
            this._events = [];
        }
        this.scheduleRestoreScroll();
    }

    get selectedDate(): Date {
        return fromStateIso(this._selectedDateIso);
    }
    set selectedDate(value: Date | string | undefined) {
        this._selectedDateIso = toStateIsoOrUnselected(value);
    }

    get user(): User {
        return this._user;
    }
    set user(value: User | string) {
        if (typeof value === "object" && value !== null) {
            this._user = value as User;
        } else if (typeof value === "string") {
            try {
                this._user = JSON.parse(value);
            } catch (e) {
                console.error("Invalid user JSON:", value);
            }
        }
    }

    // ========== 私有属性 ==========
    private onDateClick?: (date: Date) => void;
    private onDateDoubleClick?: (date: Date) => void;
    private onEventClick?: (event: Event) => void;
    private onEventDelete?: (event: Event) => void;

    constructor() {
        super({
            styles,
            styleName: "wsx-week-view",
        });
        // 在构造函数中初始化"今天"的日期，确保只计算一次
        const today = new Date();
        today.setHours(0, 0, 0, 0);
        this._today = today;
    }

    // ========== 生命周期 ==========
    onConnected() {
        super.onConnected?.();
        // 框架可能在升级前就赋值，需重新过 setter
        upgradeProperties(this, UPGRADABLE_PROPS);
        this.initializeFromAttributes();
        this.setupScrollListener();
        this.restoreScrollPosition();
        this.scheduleRestoreScroll();
    }

    onRendered() {
        super.onRendered?.();
        this.restoreScrollPosition();
    }

    onDisconnected() {
        super.onDisconnected?.();
        this.teardownScrollListener();
    }

    private captureScrollPosition() {
        const viewEl = this.shadowRoot?.querySelector(
            ".week-view",
        ) as HTMLElement | null;
        const bodyEl = this.shadowRoot?.querySelector(
            ".week-view-body",
        ) as HTMLElement | null;
        const currentScroll = viewEl?.scrollTop || bodyEl?.scrollTop || 0;
        if (currentScroll > 0) {
            this._scrollTop = currentScroll;
        }
    }

    private restoreScrollPosition = () => {
        if (this._scrollTop > 0) {
            const viewEl = this.shadowRoot?.querySelector(
                ".week-view",
            ) as HTMLElement | null;
            if (viewEl && viewEl.scrollTop !== this._scrollTop) {
                viewEl.scrollTop = this._scrollTop;
            }
            const bodyEl = this.shadowRoot?.querySelector(
                ".week-view-body",
            ) as HTMLElement | null;
            if (bodyEl && bodyEl.scrollTop !== this._scrollTop) {
                bodyEl.scrollTop = this._scrollTop;
            }
        }
    };

    private scheduleRestoreScroll() {
        if (this._scrollTop > 0 && typeof requestAnimationFrame === "function") {
            requestAnimationFrame(() => {
                this.restoreScrollPosition();
            });
        }
    }

    private setupScrollListener() {
        const viewEl = this.shadowRoot?.querySelector(".week-view") as HTMLElement | null;
        if (viewEl) {
            viewEl.addEventListener("scroll", this.handleScroll, { passive: true });
            this._viewportHeight = viewEl.clientHeight || 600;
        }
        const body = this.shadowRoot?.querySelector(".week-view-body") as HTMLElement | null;
        if (body) {
            body.addEventListener("scroll", this.handleScroll, { passive: true });
            this._viewportHeight = body.clientHeight || this._viewportHeight || 600;
        }
    }

    private teardownScrollListener() {
        const viewEl = this.shadowRoot?.querySelector(".week-view");
        if (viewEl) {
            viewEl.removeEventListener("scroll", this.handleScroll);
        }
        const body = this.shadowRoot?.querySelector(".week-view-body");
        if (body) {
            body.removeEventListener("scroll", this.handleScroll);
        }
    }

    private handleScroll = (e: globalThis.Event) => {
        const target = e.currentTarget as HTMLElement;
        this._scrollTop = target.scrollTop;
        if (target.clientHeight) {
            this._viewportHeight = target.clientHeight;
        }
        if (this._events.length > 15) {
            const bucket = Math.floor(this._scrollTop / 48);
            if (bucket !== this._virtualScrollBucket) {
                this._virtualScrollBucket = bucket;
            }
        }
    };


    onAttributeChanged(
        name: string,
        oldValue: string | null,
        newValue: string | null,
    ) {
        this.captureScrollPosition();
        super.onAttributeChanged?.(name, oldValue ?? "", newValue ?? "");

        switch (name) {
            case "view-date":
                if (newValue) {
                    this.viewDate = newValue;
                }
                break;
            case "events":
                if (newValue) {
                    this.events = newValue;
                } else {
                    this.events = [];
                }
                break;
            case "selected-date":
                if (newValue) {
                    this.selectedDate = newValue;
                } else {
                    this.selectedDate = undefined;
                }
                break;
            case "user":
                if (newValue) {
                    this.user = newValue;
                }
                break;
        }
    }

    // ========== 初始化 ==========
    private initializeFromAttributes() {
        const viewDateAttr = this.getAttribute("view-date");
        if (viewDateAttr) {
            this.viewDate = viewDateAttr;
        }

        const eventsAttr = this.getAttribute("events");
        if (eventsAttr) {
            this.events = eventsAttr;
        }

        const selectedDateAttr = this.getAttribute("selected-date");
        if (selectedDateAttr) {
            this.selectedDate = selectedDateAttr;
        } else {
            this.selectedDate = undefined;
        }

        const userAttr = this.getAttribute("user");
        if (userAttr) {
            this.user = userAttr;
        }
    }

    // ========== Getters ==========
    private get weekDates() {
        // 使用 firstDayOfWeek = 0（周日）以匹配周视图从周日开始
        return getWeekDates(this.viewDate, 0);
    }

    private get hours() {
        return Array.from({ length: 24 }, (_, i) => i);
    }

    /**
     * 视口内可见事件（RFC-0023 虚拟滚动）
     * 当单日事件数量 <= 15 时全量渲染；> 15 时仅渲染视口及缓冲区范围内的事件。
     */
    private getVisibleEventsForDay(events: Event[], dayStart: Date, dayEnd: Date): Event[] {
        void this._virtualScrollBucket;
        if (events.length <= 15) {
            return events;
        }

        const totalHeight = 24 * 48;
        const viewportHeight = this._viewportHeight || 600;
        const scrollTop = this._scrollTop || 0;

        const buffer = 150;
        const viewTopPx = Math.max(0, scrollTop - buffer);
        const viewBottomPx = scrollTop + viewportHeight + buffer;

        const viewTopPct = (viewTopPx / totalHeight) * 100;
        const viewBottomPct = (viewBottomPx / totalHeight) * 100;

        return events
            .filter((event) => {
                const pos = calculateEventPosition(event, dayStart, dayEnd);
                const eventTopPct = pos.top;
                const eventBottomPct = pos.top + pos.height;
                return (
                    eventBottomPct >= viewTopPct &&
                    eventTopPct <= viewBottomPct
                );
            })
            .slice(0, 60);
    }

    // ========== 事件处理 ==========
    private handleDateClick = (date: Date) => {
        if (this.onDateClick) {
            this.onDateClick(date);
        }
        this.dispatchEvent(
            new CustomEvent("date-click", {
                detail: { date },
                bubbles: true,
            }),
        );
    };

    private handleDateDoubleClick = (date: Date) => {
        if (this.onDateDoubleClick) {
            this.onDateDoubleClick(date);
        }
        this.dispatchEvent(
            new CustomEvent("date-double-click", {
                detail: { date },
                bubbles: true,
            }),
        );
    };

    private handleSlotClick = (date: Date, hour: number) => {
        const slotDate = new Date(date);
        slotDate.setHours(hour, 0, 0, 0);
        this.dispatchEvent(
            new CustomEvent("slot-click", {
                detail: { date: slotDate, hour },
                bubbles: true,
            }),
        );
    };

    private handleEventClick = (event: Event) => {
        if (this._suppressNextClick) {
            this._suppressNextClick = false;
            return;
        }
        if (this.onEventClick) {
            this.onEventClick(event);
        }
        this.dispatchEvent(
            new CustomEvent("event-click", {
                detail: { event },
                bubbles: true,
            }),
        );
    };

    /**
     * 事件移动改时间/改日期（RFC-0032）：原生 HTML5 DnD 手势识别对真实指针输入不稳定
     * （实测真实鼠标拖拽有时完全不触发 dragstart），换成 pointer-event 自建拖拽并提供
     * 实时跟手预览。松手时用 elementFromPoint 找落点列/格，换算新的 startTime/endTime。
     */
    // 拖拽判定阈值（px）：低于此位移视为点击而非拖拽，保留点击打开事件的行为
    private static readonly DRAG_THRESHOLD = 4;
    private _suppressNextClick = false;

    private handleEventPointerDown = (e: PointerEvent, event: Event) => {
        if (e.button !== 0) return;
        if (e.composedPath().some((target) =>
            target instanceof HTMLElement && target.matches(".week-view-resize-handle"),
        )) {
            this.handleResizePointerDown(e, event);
            return;
        }
        e.stopPropagation();
        e.preventDefault();

        startPointerDrag(e, {
            onMove: (dx, dy) => {
                this._dragPreview = { eventId: event.id, dx, dy };
            },
            onEnd: (dx, dy, upEvent) => {
                this._dragPreview = null;
                const moved =
                    Math.abs(dx) > WeekView.DRAG_THRESHOLD ||
                    Math.abs(dy) > WeekView.DRAG_THRESHOLD;
                if (moved) {
                    this._suppressNextClick = true;
                    this.commitEventDrop(event, upEvent.clientX, upEvent.clientY);
                }
            },
            onCancel: () => {
                this._dragPreview = null;
            },
        });
    };

    private commitEventDrop = (event: Event, clientX: number, clientY: number) => {
        const dropTarget = findMatchAtPoint(clientX, clientY, ".week-view-hour-cell");
        if (!dropTarget) return;

        const targetDateMs = Number(dropTarget.dataset.columnDate);
        const targetHour = Number(dropTarget.dataset.hour);
        if (Number.isNaN(targetDateMs) || Number.isNaN(targetHour)) return;
        const targetBounds = dropTarget.getBoundingClientRect();
        const targetMinute = snapMinuteWithinHour(
            clientY - targetBounds.top,
            targetBounds.height || DEFAULT_HOUR_CELL_HEIGHT_PX,
        );

        const originalStart = new Date(event.startTime);
        const originalEnd = new Date(event.endTime);
        const durationMs = originalEnd.getTime() - originalStart.getTime();

        const newStart = new Date(targetDateMs);
        newStart.setHours(targetHour, targetMinute, originalStart.getSeconds(), 0);
        const newEnd = new Date(newStart.getTime() + durationMs);

        const updatedEvent: Event = {
            ...event,
            startTime: newStart,
            endTime: newEnd,
        };

        this.dispatchEvent(
            new CustomEvent("event-update-request", {
                detail: { event: updatedEvent },
                bubbles: true,
            }),
        );
    };

    private handleResizePointerDown = (e: PointerEvent, event: Event) => {
        e.stopPropagation();
        e.preventDefault();
        const element = e.currentTarget as HTMLElement;
        const originalHeight = element.style.height;
        const originalEnd = new Date(event.endTime);
        const hourCellHeight = this.shadowRoot
            ?.querySelector(".week-view-hour-cell")
            ?.getBoundingClientRect().height || DEFAULT_HOUR_CELL_HEIGHT_PX;
        startPointerDrag(e, {
            onMove: (_dx, dy) => {
                const deltaMinutes = snapMinutesFromPixelOffset(dy, hourCellHeight);
                const deltaPx = (deltaMinutes / 60) * hourCellHeight;
                element.style.height = `calc(${originalHeight} + ${deltaPx}px)`;
            },
            onEnd: (_dx, dy) => {
                element.style.height = originalHeight;
                const deltaMinutes = snapMinutesFromPixelOffset(dy, hourCellHeight);
                if (!deltaMinutes) return;
                const endTime = new Date(originalEnd.getTime() + deltaMinutes * 60_000);
                if (endTime <= new Date(event.startTime)) return;
                this.dispatchEvent(new CustomEvent("event-update-request", {
                    detail: { event: { ...event, endTime } },
                    bubbles: true,
                }));
            },
            onCancel: () => { element.style.height = originalHeight; },
        }, element);
    };

    showUpdateRejected(eventId: string) {
        const element = this.shadowRoot?.querySelector<HTMLElement>(
            `[data-event-id="${CSS.escape(eventId)}"]`,
        );
        if (!element) return;
        element.classList.remove("update-rejected");
        void element.offsetWidth;
        element.classList.add("update-rejected");
        window.setTimeout(() => element.classList.remove("update-rejected"), 650);
    }

    private handleEventKeyDown = (e: KeyboardEvent, event: Event) => {
        if (e.key === "ArrowUp" || e.key === "ArrowDown") {
            e.preventDefault();
            const deltaHours = e.key === "ArrowDown" ? 1 : -1;
            const originalStart = new Date(event.startTime);
            const originalEnd = new Date(event.endTime);

            if (e.shiftKey) {
                const newEnd = new Date(
                    originalEnd.getTime() + deltaHours * 60 * 60 * 1000,
                );
                if (newEnd.getTime() <= originalStart.getTime()) return;
                const updatedEvent: Event = {
                    ...event,
                    endTime: newEnd,
                };
                this.dispatchEvent(
                    new CustomEvent("event-update-request", {
                        detail: { event: updatedEvent },
                        bubbles: true,
                    }),
                );
                return;
            }

            const durationMs = originalEnd.getTime() - originalStart.getTime();
            const newStart = new Date(
                originalStart.getTime() + deltaHours * 60 * 60 * 1000,
            );
            const newEnd = new Date(newStart.getTime() + durationMs);

            const updatedEvent: Event = {
                ...event,
                startTime: newStart,
                endTime: newEnd,
            };

            this.dispatchEvent(
                new CustomEvent("event-update-request", {
                    detail: { event: updatedEvent },
                    bubbles: true,
                }),
            );
        } else if (e.key === "Enter" || e.key === " ") {
            e.preventDefault();
            this.handleEventClick(event);
        }
    };

    // ========== 渲染 ==========
    render() {
        return (
            <div
                class="week-view"
                key="week-view"
                onScroll={this.handleScroll}
            >
                <div class="week-view-header" key="week-view-header">
                    <div
                        class="week-view-time-gutter"
                        key="week-view-header-gutter"
                    ></div>
                    {this.weekDates.map((date) => {
                        // 确保日期对象的时间部分为 0，便于准确比较
                        const normalizedDate = new Date(date);
                        normalizedDate.setHours(0, 0, 0, 0);
                        const dayKey = normalizedDate.getTime();

                        // 检查 selectedDate 是否是有效日期（不是 1970-01-01）
                        const isSelected =
                            this.selectedDate.getTime() !== 0 &&
                            isSameDay(normalizedDate, this.selectedDate);
                        // 使用规范化后的日期与 _today 比较
                        const isToday = isSameDay(normalizedDate, this._today);
                        const dayEvents = sortEventsByTime(
                            getEventsForDate(this.events, normalizedDate),
                        );

                        return (
                            <div
                                class={`week-view-day-header ${
                                    isToday ? "today" : ""
                                }`}
                                key={`week-header-${dayKey}`}
                                onClick={() =>
                                    this.handleDateClick(normalizedDate)
                                }
                            >
                                <div
                                    class="week-view-day-name"
                                    key={`week-header-name-${dayKey}`}
                                >
                                    {
                                        [
                                            "日",
                                            "一",
                                            "二",
                                            "三",
                                            "四",
                                            "五",
                                            "六",
                                        ][normalizedDate.getDay()]
                                    }
                                </div>
                                <div
                                    class="week-view-day-date"
                                    key={`week-header-date-${dayKey}`}
                                >
                                    {normalizedDate.getDate()}
                                </div>
                                <div
                                    class="week-view-day-events-count"
                                    key={`week-header-count-${dayKey}`}
                                >
                                    {dayEvents.length} 个事件
                                </div>
                            </div>
                        );
                    })}
                </div>
                <div
                    class="week-view-body"
                    key="week-view-body"
                    onScroll={this.handleScroll}
                >
                    <div
                        class="week-view-time-gutter"
                        key="week-view-body-gutter"
                    >
                        {this.hours.map((hour) => {
                            const hourStr = hour < 10 ? `0${hour}` : `${hour}`;
                            const timeStr = `${hourStr}:00`;
                            return (
                                <div
                                    class="week-view-time-label"
                                    key={"time-gutter-label-" + hour}
                                >
                                    {timeStr}
                                </div>
                            );
                        })}
                    </div>
                    <div class="week-view-columns" key="week-view-columns">
                        {this.weekDates.map((date) => {
                            // 确保日期对象的时间部分为 0，便于准确比较
                            const normalizedDate = new Date(date);
                            normalizedDate.setHours(0, 0, 0, 0);

                            const dayEvents = sortEventsByTime(
                                getEventsForDate(this.events, normalizedDate),
                            );
                            const dayStart = new Date(normalizedDate);
                            dayStart.setHours(0, 0, 0, 0);
                            const dayEnd = new Date(normalizedDate);
                            dayEnd.setHours(23, 59, 59, 999);

                            return (
                                <div
                                    class="week-view-day-column"
                                    key={
                                        "day-column-" + normalizedDate.getTime()
                                    }
                                >
                                    {this.hours.map((hour) => {
                                        return (
                                            <div
                                                class="week-view-hour-cell"
                                                key={
                                                    "time-slot-cell-" +
                                                    normalizedDate.getTime() +
                                                    "-" +
                                                    hour
                                                }
                                                data-column-date={normalizedDate.getTime()}
                                                data-hour={hour}
                                                onClick={() =>
                                                    this.handleSlotClick(
                                                        normalizedDate,
                                                        hour,
                                                    )
                                                }
                                            ></div>
                                        );
                                    })}
                                    {this.getVisibleEventsForDay(dayEvents, dayStart, dayEnd).map((event) => {
                                        const position = calculateEventPosition(
                                            event,
                                            dayStart,
                                            dayEnd,
                                        );

                                        const eventColor =
                                            event.color || "#4285f4";
                                        const eventDescription = event.data
                                            ?.description as string | undefined;
                                        const preview =
                                            this._dragPreview?.eventId === event.id
                                                ? this._dragPreview
                                                : null;
                                        const previewStyle = preview
                                            ? `transform: translate(${preview.dx}px, ${preview.dy}px); z-index: 20;`
                                            : "";

                                        return (
                                            <div
                                                class={
                                                    "week-view-event draggable" +
                                                    (preview ? " dragging" : "")
                                                }
                                                key={
                                                    "time-slot-event-" +
                                                    event.id
                                                }
                                                data-event-id={event.id}
                                                style={`top: ${position.top}%; height: ${position.height}%; background-color: ${eventColor}; ${previewStyle}`}
                                                tabIndex={0}
                                                onPointerDown={(e: PointerEvent) =>
                                                    this.handleEventPointerDown(e, event)
                                                }
                                                onKeyDown={(e: KeyboardEvent) =>
                                                    this.handleEventKeyDown(e, event)
                                                }
                                                onClick={() =>
                                                    this.handleEventClick(event)
                                                }
                                            >
                                                <div
                                                    class="week-view-event-time"
                                                    key={`time-slot-event-${event.id}-time`}
                                                >
                                                    {getTimeString(
                                                        event.startTime,
                                                    )}{" "}
                                                    -{" "}
                                                    {getTimeString(
                                                        event.endTime,
                                                    )}
                                                </div>
                                                <div
                                                    class="week-view-event-title"
                                                    key={`time-slot-event-${event.id}-title`}
                                                >
                                                    {event.title}
                                                </div>
                                                {eventDescription && (
                                                    <div
                                                        class="week-view-event-description"
                                                        key={`time-slot-event-${event.id}-desc`}
                                                    >
                                                        {eventDescription}
                                                    </div>
                                                )}
                                                <div
                                                    class="week-view-resize-handle"
                                                    key={`time-slot-event-${event.id}-resize`}
                                                    title="拖拽修改时长"
                                                ></div>
                                            </div>
                                        );
                                    })}
                                </div>
                            );
                        })}
                    </div>
                </div>
            </div>
        );
    }
}

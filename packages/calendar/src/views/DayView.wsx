/** @jsxImportSource @wsxjs/wsx-core */
import { WebComponent, autoRegister, state } from "@wsxjs/wsx-core";
import type { Event } from "@calenderjs/event-model";
import type { User } from "@calenderjs/core";
import { isSameDay, getTimeString, getDayHours } from "@calenderjs/date-time";
import {
    getEventsForDate,
    sortEventsByTime,
    calculateEventPosition,
} from "../utils/event-utils";
import {
    fromStateIso,
    normalizeEventsForState,
    toStateIso,
} from "../utils/state-date";
import { upgradeProperties } from "../utils/upgrade-property";
import styles from "./DayView.css?inline";

/** 需要在 customElements 升级时补写的公开属性 */
const UPGRADABLE_PROPS = ["viewDate", "events", "user"] as const;

/**
 * 日视图组件
 */
@autoRegister({ tagName: "wsx-day-view" })
export default class DayView extends WebComponent {
    // ========== 观察的属性 ==========
    static get observedAttributes() {
        return ["view-date", "events", "user"];
    }

    // ========== 内部状态 ==========
    // 日期存 ISO：避免 WSX reactive Proxy 破坏 Date
    @state private _viewDateIso: string = new Date().toISOString();
    @state private _events: Event[] = [];
    @state private _user: User = {
        id: "1",
        email: "john.doe@example.com",
        role: "user",
    };
    @state private _scrollTop: number = 0;
    @state private _viewportHeight: number = 0;
    // 保存"今天"的日期，确保在切换视图时不会改变
    private readonly _today: Date;

    // ========== Property 访问器（WSX 组件之间使用） ==========
    get viewDate(): Date {
        return fromStateIso(this._viewDateIso);
    }
    set viewDate(value: Date | string) {
        try {
            this._viewDateIso = toStateIso(value);
        } catch {
            // 忽略无效日期
        }
    }

    get events(): Event[] {
        return this._events;
    }
    set events(value: Event[] | string) {
        if (Array.isArray(value)) {
            this._events = normalizeEventsForState(value) as Event[];
        } else if (typeof value === "string") {
            try {
                const parsed = JSON.parse(value) as Event[];
                this._events = Array.isArray(parsed)
                    ? (normalizeEventsForState(parsed) as Event[])
                    : [];
            } catch (e) {
                console.error("Invalid events JSON:", value);
                this._events = [];
            }
        } else {
            this._events = [];
        }
    }

    get user(): User {
        return this._user;
    }
    set user(value: User | string) {
        if (typeof value === "object" && value !== null) {
            this._user = value as User;
        } else if (typeof value === "string") {
            try {
                this._user = JSON.parse(value);
            } catch (e) {
                console.error("Invalid user JSON:", value);
            }
        }
    }

    // ========== 私有属性 ==========
    private onEventClick?: (event: Event) => void;

    constructor() {
        super({
            styles,
            styleName: "wsx-day-view",
        });
        // 在构造函数中初始化"今天"的日期，确保只计算一次
        const today = new Date();
        today.setHours(0, 0, 0, 0);
        this._today = today;
    }

    // ========== 生命周期 ==========
    onConnected() {
        super.onConnected?.();
        // 框架可能在升级前就赋值，需重新过 setter
        upgradeProperties(this, UPGRADABLE_PROPS);
        this.initializeFromAttributes();
        this.setupScrollListener();
    }

    onDisconnected() {
        super.onDisconnected?.();
        this.teardownScrollListener();
    }

    private setupScrollListener() {
        const body = this.shadowRoot?.querySelector(".day-view-body") as HTMLElement | null;
        if (body) {
            body.addEventListener("scroll", this.handleScroll, { passive: true });
            this._viewportHeight = body.clientHeight || 600;
        }
    }

    private teardownScrollListener() {
        const body = this.shadowRoot?.querySelector(".day-view-body");
        if (body) {
            body.removeEventListener("scroll", this.handleScroll);
        }
    }

    private handleScroll = (e: globalThis.Event) => {
        const target = e.currentTarget as HTMLElement;
        this._scrollTop = target.scrollTop;
        if (target.clientHeight) {
            this._viewportHeight = target.clientHeight;
        }
    };

    onAttributeChanged(
        name: string,
        oldValue: string | null,
        newValue: string | null,
    ) {
        super.onAttributeChanged?.(name, oldValue ?? "", newValue ?? "");

        switch (name) {
            case "view-date":
                if (newValue) {
                    this.viewDate = newValue;
                }
                break;
            case "events":
                if (newValue) {
                    this.events = newValue;
                } else {
                    this.events = [];
                }
                break;
            case "user":
                if (newValue) {
                    this.user = newValue;
                }
                break;
        }
    }

    // ========== 初始化 ==========
    private initializeFromAttributes() {
        const viewDateAttr = this.getAttribute("view-date");
        if (viewDateAttr) {
            this.viewDate = viewDateAttr;
        }

        const eventsAttr = this.getAttribute("events");
        if (eventsAttr) {
            this.events = eventsAttr;
        }

        const userAttr = this.getAttribute("user");
        if (userAttr) {
            this.user = userAttr;
        }
    }

    // ========== Getters ==========
    private get dayEvents() {
        return sortEventsByTime(getEventsForDate(this.events, this.viewDate));
    }

    /**
     * 虚拟化过滤（RFC-0023）：
     * 当单日事件较少（<= 20）时全量渲染，保持小数据量简单稳定；
     * 当单日事件远超视口（> 20）时，根据当前滚动视口动态回收视口外的 DOM 节点。
     */
    private get visibleEvents() {
        const events = this.dayEvents;
        if (events.length <= 20) {
            return events;
        }

        // 总时间轴高度：24 小时 * 48px = 1152px
        const totalHeight = 24 * 48;
        const viewportHeight = this._viewportHeight || 600;
        const scrollTop = this._scrollTop || 0;

        // 视口上下预留 150px 缓冲区，保证滚动平滑且能看见边缘事件
        const buffer = 150;
        const viewTopPx = Math.max(0, scrollTop - buffer);
        const viewBottomPx = scrollTop + viewportHeight + buffer;

        const viewTopPct = (viewTopPx / totalHeight) * 100;
        const viewBottomPct = (viewBottomPx / totalHeight) * 100;

        return events.filter((event) => {
            const pos = calculateEventPosition(event, this.dayStart, this.dayEnd);
            const eventTopPct = pos.top;
            const eventBottomPct = pos.top + pos.height;
            // 判断与视口区间是否有重叠
            return eventBottomPct >= viewTopPct && eventTopPct <= viewBottomPct;
        });
    }

    private get hours() {
        return getDayHours();
    }

    private get dayStart() {
        const dayStart = new Date(this.viewDate);
        dayStart.setHours(0, 0, 0, 0);
        return dayStart;
    }

    private get dayEnd() {
        const dayEnd = new Date(this.viewDate);
        dayEnd.setHours(23, 59, 59, 999);
        return dayEnd;
    }

    // ========== 事件处理 ==========
    private handleSlotClick = (hour: number) => {
        const slotDate = new Date(this.viewDate);
        slotDate.setHours(hour, 0, 0, 0);
        this.dispatchEvent(
            new CustomEvent("slot-click", {
                detail: { date: slotDate, hour },
                bubbles: true,
            }),
        );
    };

    private handleEventClick = (event: Event) => {
        if (this.onEventClick) {
            this.onEventClick(event);
        }
        // 触发自定义事件
        this.dispatchEvent(
            new CustomEvent("event-click", {
                detail: { event },
                bubbles: true,
            }),
        );
    };

    private handleDragStart = (e: DragEvent, event: Event) => {
        if (!e.dataTransfer) return;
        const target = e.currentTarget as HTMLElement;
        target.classList.add("dragging");
        e.dataTransfer.effectAllowed = "move";
        e.dataTransfer.setData("application/json", JSON.stringify(event));
    };

    private handleDragEnd = (e: DragEvent) => {
        const target = e.currentTarget as HTMLElement;
        target.classList.remove("dragging");
    };

    private handleDragOver = (e: DragEvent) => {
        e.preventDefault();
        if (e.dataTransfer) {
            e.dataTransfer.dropEffect = "move";
        }
    };

    private handleDrop = (e: DragEvent, targetHour: number) => {
        e.preventDefault();
        const data = e.dataTransfer?.getData("application/json");
        if (!data) return;
        try {
            const event = JSON.parse(data) as Event;
            const originalStart = new Date(event.startTime);
            const originalEnd = new Date(event.endTime);
            const durationMs = originalEnd.getTime() - originalStart.getTime();

            const newStart = new Date(this.viewDate);
            newStart.setHours(targetHour, originalStart.getMinutes(), originalStart.getSeconds(), 0);
            const newEnd = new Date(newStart.getTime() + durationMs);

            const updatedEvent: Event = {
                ...event,
                startTime: newStart,
                endTime: newEnd,
            };

            this.dispatchEvent(
                new CustomEvent("event-update-request", {
                    detail: { event: updatedEvent },
                    bubbles: true,
                }),
            );
        } catch (err) {
            console.error("Failed to parse dragged event:", err);
        }
    };

    private handleResizeMouseDown = (e: MouseEvent, event: Event) => {
        e.stopPropagation();
        e.preventDefault();

        const startY = e.clientY;
        const originalEnd = new Date(event.endTime);

        const onMouseMove = (moveEvent: MouseEvent) => {};

        const onMouseUp = (upEvent: MouseEvent) => {
            window.removeEventListener("mousemove", onMouseMove);
            window.removeEventListener("mouseup", onMouseUp);

            const deltaY = upEvent.clientY - startY;
            const hoursDelta = Math.round(deltaY / 48);
            if (hoursDelta === 0) return;

            const newEnd = new Date(originalEnd.getTime() + hoursDelta * 60 * 60 * 1000);
            const start = new Date(event.startTime);
            if (newEnd.getTime() <= start.getTime()) return;

            const updatedEvent: Event = {
                ...event,
                endTime: newEnd,
            };

            this.dispatchEvent(
                new CustomEvent("event-update-request", {
                    detail: { event: updatedEvent },
                    bubbles: true,
                }),
            );
        };

        window.addEventListener("mousemove", onMouseMove);
        window.addEventListener("mouseup", onMouseUp);
    };

    private handleEventKeyDown = (e: KeyboardEvent, event: Event) => {
        if (e.key === "ArrowUp" || e.key === "ArrowDown") {
            e.preventDefault();
            const deltaHours = e.key === "ArrowDown" ? 1 : -1;
            const originalStart = new Date(event.startTime);
            const originalEnd = new Date(event.endTime);

            if (e.shiftKey) {
                const newEnd = new Date(
                    originalEnd.getTime() + deltaHours * 60 * 60 * 1000,
                );
                if (newEnd.getTime() <= originalStart.getTime()) return;
                const updatedEvent: Event = {
                    ...event,
                    endTime: newEnd,
                };
                this.dispatchEvent(
                    new CustomEvent("event-update-request", {
                        detail: { event: updatedEvent },
                        bubbles: true,
                    }),
                );
                return;
            }

            const durationMs = originalEnd.getTime() - originalStart.getTime();
            const newStart = new Date(
                originalStart.getTime() + deltaHours * 60 * 60 * 1000,
            );
            const newEnd = new Date(newStart.getTime() + durationMs);

            const updatedEvent: Event = {
                ...event,
                startTime: newStart,
                endTime: newEnd,
            };

            this.dispatchEvent(
                new CustomEvent("event-update-request", {
                    detail: { event: updatedEvent },
                    bubbles: true,
                }),
            );
        } else if (e.key === "Enter" || e.key === " ") {
            e.preventDefault();
            this.handleEventClick(event);
        }
    };

    // ========== 渲染 ==========
    render() {
        return (
            <div class="day-view">
                <div class="day-view-header">
                    <div
                        class={`day-view-date ${
                            isSameDay(this.viewDate, this._today) ? "today" : ""
                        }`}
                    >
                        {this.viewDate.getFullYear()}年
                        {this.viewDate.getMonth() + 1}月
                        {this.viewDate.getDate()}日
                    </div>
                    <div class="day-view-events-count">
                        {this.dayEvents.length} 个事件
                    </div>
                </div>
                <div class="day-view-body">
                    <div class="day-view-time-column">
                        {this.hours.map((hour) => {
                            const hourStr = hour < 10 ? `0${hour}` : `${hour}`;
                            const timeStr = `${hourStr}:00`;
                            return (
                                <div
                                    class="day-view-hour-label"
                                    key={`left-hour-${hour}`}
                                >
                                    {timeStr}
                                </div>
                            );
                        })}
                    </div>
                    <div class="day-view-events-column">
                        {this.hours.map((hour) => {
                            return (
                                <div
                                    class="day-view-hour-cell"
                                    key={`right-hour-${hour}`}
                                    onClick={() => this.handleSlotClick(hour)}
                                    onDragOver={this.handleDragOver}
                                    onDrop={(e: DragEvent) =>
                                        this.handleDrop(e, hour)
                                    }
                                ></div>
                            );
                        })}
                        {this.visibleEvents.map((event) => {
                            const position = calculateEventPosition(
                                event,
                                this.dayStart,
                                this.dayEnd,
                            );
                            const eventColor = event.color || "#4285f4";
                            const eventDescription = event.data
                                ?.description as string | undefined;

                            return (
                                <div
                                    class="day-view-event draggable"
                                    key={event.id}
                                    style={`top: ${position.top}%; height: ${position.height}%; background-color: ${eventColor}`}
                                    draggable="true"
                                    tabIndex={0}
                                    onDragStart={(e: DragEvent) =>
                                        this.handleDragStart(e, event)
                                    }
                                    onDragEnd={this.handleDragEnd}
                                    onKeyDown={(e: KeyboardEvent) =>
                                        this.handleEventKeyDown(e, event)
                                    }
                                    onClick={() => this.handleEventClick(event)}
                                    title={event.title}
                                >
                                    <div class="day-view-event-time">
                                        {getTimeString(event.startTime)} -{" "}
                                        {getTimeString(event.endTime)}
                                    </div>
                                    <div class="day-view-event-title">
                                        {event.title}
                                    </div>
                                    {eventDescription && (
                                        <div class="day-view-event-description">
                                            {eventDescription}
                                        </div>
                                    )}
                                    <div
                                        class="day-view-resize-handle"
                                        title="拖拽修改时长"
                                        onMouseDown={(e: MouseEvent) =>
                                            this.handleResizeMouseDown(e, event)
                                        }
                                    ></div>
                                </div>
                            );
                        })}
                    </div>
                </div>
            </div>
        );
    }
}
